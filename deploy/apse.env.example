# Replace all examples locally. Never include real secrets in a distributable archive.
APSE_PUBLIC_ORIGIN=https://YOUR-HOST
DHIS2_URL=https://YOUR-HOST/dhis
APSE_PATH=/dhis/apse-service
APSE_PORT=8765
APSE_DB=/var/lib/apse/apse.sqlite
APSE_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY_LOCALLY
APSE_AUDIT_KEY=GENERATE_A_SEPARATE_64_CHARACTER_RANDOM_SECRET
APSE_BACKUP_KEY=GENERATE_A_SEPARATE_FERNET_KEY_LOCALLY
# Publisher token is needed only for the optional approved-data mirror job.
DHIS2_PUBLISHER_TOKEN=SET_ONLY_FOR_PUBLISHER_JOB
# Optional: run Ollama on the same host, install a suitable multilingual model,
# then set its actual local model name. Empty disables the writing assistant.
APSE_OLLAMA_MODEL=
