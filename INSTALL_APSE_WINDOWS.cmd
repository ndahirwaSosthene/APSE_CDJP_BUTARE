@echo off
setlocal
cd /d "%~dp0"
set "APSE_SETUP_DIR=%~dp0"
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { $src=$env:APSE_SETUP_DIR; $py=Join-Path $src 'runtime\windows\python.exe'; if (-not (Test-Path -LiteralPath $py)) { throw 'Extract ALL files first. Do not run inside ZIP.' }; & $py -X utf8 (Join-Path $src 'scripts\verify_install.py'); if ($LASTEXITCODE -ne 0) { throw 'Files missing or changed. Extract the complete package again.' }; $target=Join-Path $env:LOCALAPPDATA 'CDJPButare\APSE_0.8.1'; if (Test-Path -LiteralPath $target) { throw 'Installation already exists. Open START_APSE_WINDOWS.cmd there, or use the extracted portable folder.' }; $probe=New-Object Net.Sockets.TcpClient; try { if ($probe.ConnectAsync('127.0.0.1',8766).Wait(500) -and $probe.Connected) { throw 'Stop APSE with Ctrl+C before setup.' } } catch [System.AggregateException] {} finally { $probe.Dispose() }; New-Item -ItemType Directory -Path $target -Force | Out-Null; Get-ChildItem -LiteralPath $src -Force | Copy-Item -Destination $target -Recurse; $new=Join-Path $target 'portable_data'; if (-not (Test-Path -LiteralPath $new)) { foreach ($version in @('0.8.0','0.7.1')) { $old=Join-Path $env:LOCALAPPDATA ('CDJPButare\APSE_'+$version+'\portable_data'); if (Test-Path -LiteralPath (Join-Path $old 'apse.sqlite')) { & (Join-Path $target 'runtime\windows\python.exe') -X utf8 (Join-Path $target 'scripts\migrate_local.py') --source $old --target $new; if ($LASTEXITCODE -ne 0) { throw 'Data migration failed; original kept. Do not create a new vault.' }; break } } }; $shell=New-Object -ComObject WScript.Shell; $link=$shell.CreateShortcut((Join-Path ([Environment]::GetFolderPath('Desktop')) 'CDJP Butare - APSE.lnk')); $link.TargetPath=$env:ComSpec; $link.Arguments='/d /c START_APSE_WINDOWS.cmd'; $link.WorkingDirectory=$target; $link.Save(); Write-Host ('Installed: '+$target); Start-Process -FilePath $env:ComSpec -ArgumentList '/d','/c','START_APSE_WINDOWS.cmd' -WorkingDirectory $target; exit 0 } catch { Write-Host $_.Exception.Message -ForegroundColor Red; exit 1 }"
if errorlevel 1 pause
